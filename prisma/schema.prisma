generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RESIDENT
  ADMIN
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PriorityLabel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NoticeType {
  GENERAL
  MAINTENANCE
  EMERGENCY
  EVENT
}

model Society {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  locations       Location[]
  complaints      Complaint[]
  complaintGroups ComplaintGroup[]
  slas            SLA[]
  notices         Notice[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RESIDENT)

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  complaintsReported Complaint[] @relation("ComplaintReporter")
  complaintsAssigned Complaint[] @relation("ComplaintAssignee")

  comments      ComplaintComment[]
  statusChanges ComplaintStatusHistory[] @relation("StatusChangedBy")
  ratings       SatisfactionRating[]
  notices       Notice[]                 @relation("NoticeAuthor")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsCreated  Notification[] @relation("NotificationCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([role])
}

model Location {
  id          String  @id @default(cuid())
  name        String
  block       String?
  floor       String?
  description String?

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  complaints Complaint[]

  qrCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
}

model Complaint {
  id          String @id @default(cuid())
  title       String
  description String
  category    String
  severity    Int    @default(3)

  priorityScore Int           @default(0)
  priorityLabel PriorityLabel @default(MEDIUM)

  affectedResidentsEstimated Int  @default(1)
  affectedResidentsVerified  Int?

  status ComplaintStatus @default(OPEN)

  reporterId String
  reporter   User   @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  groupId String?
  group   ComplaintGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  slaId String?
  sla   SLA?    @relation(fields: [slaId], references: [id], onDelete: SetNull)

  dueAt DateTime?

  comments           ComplaintComment[]
  statusHistory      ComplaintStatusHistory[]
  satisfactionRating SatisfactionRating?
  notifications      Notification[]

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([locationId])
  @@index([status])
  @@index([priorityLabel])
  @@index([category])
  @@index([groupId])
  @@index([assignedToId])
}

model ComplaintComment {
  id      String @id @default(cuid())
  content String

  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complaintId])
  @@index([authorId])
}

model ComplaintStatusHistory {
  id     String          @id @default(cuid())
  status ComplaintStatus
  note   String?

  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  changedById String
  changedBy   User   @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([complaintId])
  @@index([changedById])
}

model ComplaintGroup {
  id                String   @id @default(cuid())
  name              String
  category          String
  locationId        String?
  description       String?
  complaintCount    Int      @default(0)
  affectedResidents Int      @default(0)
  firstDetectedAt   DateTime @default(now())
  lastUpdatedAt     DateTime @updatedAt
  isActive          Boolean  @default(true)

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  complaints Complaint[]

  @@index([societyId])
  @@index([category])
  @@index([isActive])
}

model SLA {
  id              String         @id @default(cuid())
  name            String
  category        String?
  priorityLabel   PriorityLabel?
  resolutionHours Int

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  complaints Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([category])
  @@index([priorityLabel])
}

model SatisfactionRating {
  id      String  @id @default(cuid())
  score   Int
  comment String?

  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  residentId String
  resident   User   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residentId])
}

model Notice {
  id          String     @id @default(cuid())
  title       String
  content     String
  type        NoticeType @default(GENERAL)
  isImportant Boolean    @default(false)

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId])
  @@index([createdAt])
}

model Notification {
  id      String  @id @default(cuid())
  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId])
  @@index([createdById])
  @@index([complaintId])
  @@index([isRead])
}
